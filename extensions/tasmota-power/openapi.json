{
  "openapi": "3.1.0",
  "info": {
    "title": "tasmota-power",
    "version": "0.3.0",
    "description": "Tasmota MQTT smart plug control and monitoring per printer."
  },
  "paths": {
    "/settings": {
      "get": {
        "operationId": "get-tasmota-settings",
        "summary": "Get MQTT broker settings and live connection status",
        "description": "Returns the structured MQTT broker configuration (with password redacted), connection state, and last error.",
        "responses": {
          "200": {
            "description": "Current MQTT settings and broker status"
          }
        }
      },
      "put": {
        "operationId": "put-tasmota-settings",
        "summary": "Save MQTT broker settings and reconnect",
        "description": "Saves structured MQTT broker settings to settings.json and reconnects the MQTT client.",
        "responses": {
          "200": {
            "description": "Updated MQTT settings and broker status"
          }
        }
      }
    },
    "/broker/test": {
      "post": {
        "operationId": "test-broker-connection",
        "summary": "Test MQTT broker connectivity",
        "description": "Tests connecting to the provided (or saved) MQTT broker settings and returns whether the connection succeeded or the exact error.",
        "responses": {
          "200": {
            "description": "MQTT broker test result"
          }
        }
      }
    },
    "/discover": {
      "post": {
        "operationId": "discover-tasmota-plugs",
        "summary": "Probe MQTT for online Tasmota plugs",
        "description": "Publishes a status query to Tasmota's group topic (cmnd/tasmotas/Power) and returns all discovered Tasmota plugs.",
        "responses": {
          "200": {
            "description": "List of discovered Tasmota plugs"
          }
        }
      }
    },
    "/assignments": {
      "get": {
        "operationId": "get-plug-assignments",
        "summary": "List all printer-to-Tasmota plug assignments and discovered plugs",
        "description": "Returns all configured printer-to-Tasmota mappings, discovered Tasmota plugs, and MQTT broker status.",
        "responses": {
          "200": {
            "description": "All printer plug assignments and discovered plugs"
          }
        }
      }
    },
    "/devices/{device_id}": {
      "get": {
        "operationId": "get-device-power",
        "summary": "Get Tasmota plug config, live power state, usage graph, and safety lock status for a printer",
        "description": "Returns the printer's configured Tasmota MQTT topic, live relay/power telemetry, rolling power graph samples, session and per-print energy totals, active-print safety lock state, and auto-off countdown.",
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Device power plug status and energy usage telemetry",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PowerStatus" }
              }
            }
          }
        }
      }
    },
    "/devices/{device_id}/config": {
      "put": {
        "operationId": "put-device-power-config",
        "summary": "Configure Tasmota MQTT topic and auto-off settings for a printer",
        "description": "Persists the printer's Tasmota MQTT topic, auto-off-after-print flag, and optional cooldown duration.",
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated device power plug status"
          }
        }
      }
    },
    "/devices/{device_id}/power": {
      "post": {
        "operationId": "post-device-power",
        "summary": "Turn a printer's Tasmota plug ON, OFF, or TOGGLE",
        "description": "Publishes ON or OFF to cmnd/<topic>/Power via MQTT. Refuses OFF or TOGGLE-to-OFF with 409 Conflict if the printer is actively printing or busy.",
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Command sent and updated plug status"
          }
        }
      }
    },
    "/devices/{device_id}/auto-off": {
      "post": {
        "operationId": "post-device-auto-off",
        "summary": "Arm or disarm automatic power-off when the current print finishes",
        "description": "Enables or disables one-shot automatic power-off after the current print finishes and the cooldown period elapses.",
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated device power plug status"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PowerSample": {
        "type": "object",
        "properties": {
          "ts": { "type": "integer", "description": "Unix timestamp in seconds" },
          "watts": { "type": "number", "description": "Instantaneous power draw in watts" }
        }
      },
      "PowerSession": {
        "type": "object",
        "properties": {
          "active": { "type": "boolean" },
          "started_at": { "type": "string", "format": "date-time" },
          "ended_at": { "type": "string", "format": "date-time" },
          "duration_sec": { "type": "integer" },
          "energy_wh": { "type": "number" },
          "avg_watts": { "type": "number" },
          "peak_watts": { "type": "number" }
        }
      },
      "PrintPowerRecord": {
        "type": "object",
        "properties": {
          "job_id": { "type": "string" },
          "file_name": { "type": "string" },
          "active": { "type": "boolean" },
          "outcome": { "type": "string" },
          "started_at": { "type": "string", "format": "date-time" },
          "ended_at": { "type": "string", "format": "date-time" },
          "duration_sec": { "type": "integer" },
          "energy_wh": { "type": "number" },
          "avg_watts": { "type": "number" },
          "peak_watts": { "type": "number" }
        }
      },
      "PowerStatus": {
        "type": "object",
        "properties": {
          "device_id": { "type": "string" },
          "mqtt_configured": { "type": "boolean" },
          "mqtt_connected": { "type": "boolean" },
          "mqtt_broker": { "type": "string" },
          "mqtt_error": { "type": "string" },
          "can_turn_off": { "type": "boolean" },
          "lock_reason": { "type": "string" },
          "printer_connected": { "type": "boolean" },
          "printer_state": { "type": "string" },
          "printer_moving": { "type": "boolean" },
          "auto_off_pending": { "type": "boolean" },
          "auto_off_remaining_sec": { "type": "integer" },
          "default_cooldown_sec": { "type": "integer" },
          "confirm_turn_off": { "type": "boolean" },
          "power_history": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PowerSample" }
          },
          "session_usage": { "$ref": "#/components/schemas/PowerSession" },
          "current_print_usage": { "$ref": "#/components/schemas/PrintPowerRecord" },
          "print_history": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PrintPowerRecord" }
          }
        }
      }
    }
  }
}
